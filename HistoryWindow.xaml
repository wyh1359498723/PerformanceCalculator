<Window x:Class="PerformanceCalculator2.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史导入数据" Height="440" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
  <DockPanel Margin="0">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Padding="12,10,12,6"
               Text="选择导入批次后可删除（将同时删除该批次的所有明细行）。"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
      <Button x:Name="BtnDelete" Content="删除所选" Padding="12,6" Margin="0,0,8,0" Click="BtnDelete_Click"/>
      <Button x:Name="BtnClose" Content="关闭" Padding="12,6" IsCancel="True" Click="BtnClose_Click"/>
    </StackPanel>
    <DataGrid x:Name="GridBatches" Margin="12,0,12,8"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
        <DataGridTextColumn Header="导入时间(本地)" Binding="{Binding CreatedLocal}" Width="160"/>
        <DataGridTextColumn Header="代表月份" Binding="{Binding MonthKey}" Width="90"/>
        <DataGridTextColumn Header="行数" Binding="{Binding RowCount}" Width="60"/>
        <DataGridTextColumn Header="来源" Binding="{Binding SourceFiles}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
