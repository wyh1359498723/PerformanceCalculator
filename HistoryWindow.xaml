<Window x:Class="PerformanceCalculator2.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据源管理" Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#05080f">
  <Window.Resources>
    <ResourceDictionary Source="/PerformanceCalculator2;component/Themes/TechShared.xaml"/>
  </Window.Resources>
  <Grid>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF060c16" Offset="0"/>
          <GradientStop Color="#FF0f1c30" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <DockPanel Margin="16">
      <Border DockPanel.Dock="Top" Style="{StaticResource TechCard}" Margin="0,0,0,12" Padding="14">
        <TextBlock TextWrapping="Wrap" Foreground="#bae6fd" LineHeight="22"
                   Text="每个 Excel 文件对应一个数据源。勾选不再需要的数据源后可批量删除，其绩效明细将一并清除（不可恢复）。"/>
      </Border>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="BtnDelete" Content="删除已勾选数据源" Style="{StaticResource TechGlowButton}" Margin="0,0,10,0"
                Background="#b91c1c" Click="BtnDelete_Click"/>
        <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource TechGhostButton}" IsCancel="True" Click="BtnClose_Click"/>
      </StackPanel>
      <Border Style="{StaticResource TechCard}" Padding="0">
        <DataGrid x:Name="GridBatches" Margin="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="选择" Width="58" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource TechCheckBox}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="数据源 ⇅" Binding="{Binding SourceFile}" SortMemberPath="SourceFile" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="导入时间（本地） ⇅" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedLocalValue" Width="180" IsReadOnly="True"/>
            <DataGridTextColumn Header="代表月份 ⇅" Binding="{Binding MonthKey}" SortMemberPath="MonthKey" Width="105" IsReadOnly="True"/>
            <DataGridTextColumn Header="有效记录 ⇅" Binding="{Binding RowCount}" SortMemberPath="RowCountValue" Width="100" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>
  </Grid>
</Window>
