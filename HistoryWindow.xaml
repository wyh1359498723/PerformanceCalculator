<Window x:Class="PerformanceCalculator2.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史导入批次" Height="480" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#05080f">
  <Window.Resources>
    <ResourceDictionary Source="/PerformanceCalculator2;component/Themes/TechShared.xaml"/>
  </Window.Resources>
  <Grid>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF060c16" Offset="0"/>
          <GradientStop Color="#FF0f1c30" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <DockPanel Margin="16">
      <Border DockPanel.Dock="Top" Style="{StaticResource TechCard}" Margin="0,0,0,12" Padding="14">
        <TextBlock TextWrapping="Wrap" Foreground="#bae6fd" LineHeight="22"
                   Text="以下为本地 SQLite 中的导入批次。勾选后可删除，对应明细将一并清除（不可恢复）。"/>
      </Border>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="BtnDelete" Content="删除所选" Style="{StaticResource TechGlowButton}" Margin="0,0,10,0"
                Background="#b91c1c" Click="BtnDelete_Click"/>
        <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource TechGhostButton}" IsCancel="True" Click="BtnClose_Click"/>
      </StackPanel>
      <Border Style="{StaticResource TechCard}" Padding="0">
        <DataGrid x:Name="GridBatches" Margin="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
            <DataGridTextColumn Header="导入时间(本地)" Binding="{Binding CreatedLocal}" Width="160"/>
            <DataGridTextColumn Header="代表月份" Binding="{Binding MonthKey}" Width="90"/>
            <DataGridTextColumn Header="行数" Binding="{Binding RowCount}" Width="60"/>
            <DataGridTextColumn Header="来源" Binding="{Binding SourceFiles}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>
  </Grid>
</Window>
