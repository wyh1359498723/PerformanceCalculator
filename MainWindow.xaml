<Window x:Class="PerformanceCalculator2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:PerformanceCalculator2"
        mc:Ignorable="d"
        Title="生产绩效控制台" Height="900" Width="1440" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Storyboard x:Key="IntroStoryboard">
      <DoubleAnimation Storyboard.TargetName="RootDock" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.45" FillBehavior="HoldEnd">
        <DoubleAnimation.EasingFunction>
          <QuadraticEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="DockSlide" Storyboard.TargetProperty="Y"
                       From="22" To="0" Duration="0:0:0.5" FillBehavior="HoldEnd">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="DragPulseStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="DropScanLine" Storyboard.TargetProperty="Opacity"
                       From="0.2" To="1" Duration="0:0:0.55" AutoReverse="True"/>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource IntroStoryboard}"/>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="RootChrome" Background="#05080f">
    <!-- 深空渐变底 -->
    <Grid x:Name="TechBackdrop" Visibility="Visible">
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1.1,1.2">
            <GradientStop Color="#FF040a12" Offset="0"/>
            <GradientStop Color="#FF0c1830" Offset="0.42"/>
            <GradientStop Color="#FF051e24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Opacity="0.35" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.85" RadiusY="0.9">
            <GradientStop Color="#3322d3ee" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <DockPanel x:Name="RootDock" Background="Transparent" Opacity="0">
      <DockPanel.RenderTransform>
        <TranslateTransform x:Name="DockSlide"/>
      </DockPanel.RenderTransform>

      <Border x:Name="PanelTop" DockPanel.Dock="Top" Padding="20,14,20,12" SnapsToDevicePixels="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Width="38" Height="38" Margin="0,0,12,0" CornerRadius="10" Background="#22d3ee">
                  <Viewbox Margin="9">
                    <Grid Width="22" Height="22">
                      <Rectangle Width="4" Height="9" Fill="#082f49" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                      <Rectangle Width="4" Height="15" Fill="#082f49" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                      <Rectangle Width="4" Height="21" Fill="#082f49" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                    </Grid>
                  </Viewbox>
                </Border>
                <TextBlock x:Name="LblTitle" Text="生产绩效控制台" FontSize="24" FontWeight="SemiBold" Foreground="#e0fbff" VerticalAlignment="Center"/>
                <Border x:Name="BadgeLine" Margin="14,7,0,0" Padding="10,3" CornerRadius="6" VerticalAlignment="Center"
                        BorderBrush="#5522d3ee" BorderThickness="1" Background="#1a2238">
                  <TextBlock x:Name="LblBadge" Text="RP0 专线 · 本地持久化" FontSize="11" Foreground="#7dd3fc" Opacity="0.95"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="LblPath" Margin="50,5,0,0" Text="尚未加载文件" TextWrapping="Wrap"
                         Foreground="#94a3b8" FontSize="12"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnExportOperatorChart" Content="导出操作员图" MinWidth="126" Height="36" Margin="0,0,8,0"
                      Click="BtnExportOperatorChart_Click"/>
              <Button x:Name="BtnExportMonthChart" Content="导出月度图" MinWidth="116" Height="36" Margin="0,0,8,0"
                      Click="BtnExportMonthChart_Click"/>
              <Button x:Name="BtnHistory" Content="数据源管理" MinWidth="116" Height="36" Margin="0,0,8,0" Click="BtnHistory_Click"/>
              <CheckBox x:Name="ChkDarkMode" Content="深色" VerticalAlignment="Center" Margin="4,0,12,0"
                        IsChecked="False" Checked="ChkDarkMode_Changed" Unchecked="ChkDarkMode_Changed"/>
              <Button x:Name="BtnSelectFiles" Content="选择 Excel" MinWidth="128" Height="36" Click="BtnSelectFiles_Click"/>
            </WrapPanel>
          </Grid>

          <Border x:Name="PanelDrop" Grid.Row="1" Height="42" CornerRadius="9" BorderThickness="1"
                  AllowDrop="True" PreviewDragOver="PanelDrop_PreviewDragOver" DragLeave="PanelDrop_DragLeave"
                  Drop="PanelDrop_Drop" PreviewDragEnter="PanelDrop_PreviewDragEnter">
            <Grid>
              <TextBlock x:Name="LblDropHint" Text="拖放 .xlsx 到此处导入 · 每个 Excel 将作为独立数据源"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7dd3fc" FontSize="12"/>
              <Border x:Name="DropScanLine" Height="2" VerticalAlignment="Bottom" Margin="24,0" CornerRadius="1"
                      Opacity="0.55" Background="#22d3ee" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <Border x:Name="PanelImportProgress" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0" Padding="8,8"
                  CornerRadius="8" BorderThickness="1" BorderBrush="#4422d3ee" Background="#120f1c">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblImportDetail" Grid.Row="0" Margin="0,0,0,6" Foreground="#bae6fd" FontSize="12"/>
              <ProgressBar x:Name="ProgressImport" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="0"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid x:Name="MainGrid" Margin="20,12,20,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="82"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
          <Border x:Name="KpiCardOperators" Margin="0,0,8,0" Padding="16,11" CornerRadius="10" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="KpiCaptionOperators" Text="操作员人数" FontSize="12"/>
                <TextBlock x:Name="LblKpiOperatorCount" Text="—" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold"/>
              </StackPanel>
              <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1822d3ee" VerticalAlignment="Center">
                <TextBlock Text="人" Foreground="#22d3ee" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Border x:Name="KpiCardEffective" Margin="4,0,4,0" Padding="16,11" CornerRadius="10" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="KpiCaptionEffective" Text="总有效工时（分）" FontSize="12"/>
                <TextBlock x:Name="LblKpiEffective" Text="—" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold"/>
              </StackPanel>
              <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1822d3ee" VerticalAlignment="Center">
                <TextBlock Text="效" Foreground="#22d3ee" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Border x:Name="KpiCardActual" Margin="4,0,4,0" Padding="16,11" CornerRadius="10" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="KpiCaptionActual" Text="总实际工时（分）" FontSize="12"/>
                <TextBlock x:Name="LblKpiActual" Text="—" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold"/>
              </StackPanel>
              <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1822d3ee" VerticalAlignment="Center">
                <TextBlock Text="实" Foreground="#22d3ee" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Border x:Name="KpiCardOee" Margin="8,0,0,0" Padding="16,11" CornerRadius="10" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="KpiCaptionOee" Text="整体 OEE" FontSize="12"/>
                <TextBlock x:Name="LblKpiOee" Text="—" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold"/>
              </StackPanel>
              <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1822d3ee" VerticalAlignment="Center">
                <TextBlock Text="%" Foreground="#22d3ee" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
        </UniformGrid>

        <Border x:Name="PanelPerf" Grid.Row="1" Margin="0,0,0,12" Padding="14,10" CornerRadius="10" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="LblPerfMonthCaption" Text="绩效表月份" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
              <ComboBox x:Name="CboPerfMonth" Width="126" Margin="0,0,14,0" VerticalAlignment="Center"
                        SelectionChanged="CboPerfMonth_SelectionChanged"/>
              <TextBlock x:Name="LblAvgEffective" Text="平均有效工时：—" VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="220"/>
              <CheckBox x:Name="ChkBelowAvg" Content="仅显示低于平均有效工时" VerticalAlignment="Center" Margin="0,0,14,0"
                        Checked="ChkBelowAvg_Changed" Unchecked="ChkBelowAvg_Changed"/>
              <Button x:Name="BtnExportPerfMonth" Content="导出当月绩效表" Padding="14,6" Click="BtnExportPerfMonth_Click"/>
            </WrapPanel>
            <Grid Grid.Row="1" Margin="0,9,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="LblChartMonthHint" Text="图表统计月份" VerticalAlignment="Top" Margin="0,5,12,0" FontSize="12" FontWeight="SemiBold"/>
              <Border x:Name="BdChartMonthPicker" Grid.Column="1" CornerRadius="7" Padding="8,4" BorderThickness="1" MaxHeight="66">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="ChartMonthItemsControl">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:SelectableMonth}">
                        <CheckBox Margin="0,2,16,2" Content="{Binding MonthKey}"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="ChartMonthCheck_Changed" Unchecked="ChartMonthCheck_Changed"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
          <Grid x:Name="CardLeft" Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions><RowDefinition Height="1.45*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="CardOperatorTable" Grid.Row="0" Margin="0,0,0,6" CornerRadius="10" BorderThickness="1" Padding="0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="LblOperatorTableTitle" Text="操作员绩效" Margin="14,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                <DataGrid x:Name="DgvOperators" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column"/>
              </Grid>
            </Border>
            <Border x:Name="CardMonthTable" Grid.Row="1" Margin="0,6,0,0" CornerRadius="10" BorderThickness="1" Padding="0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="LblMonthTableTitle" Text="月度统计" Margin="14,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                <DataGrid x:Name="DgvMonths" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"/>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="CardRight" Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="CardOperatorChart" Grid.Row="0" Margin="0,0,0,6" CornerRadius="10" BorderThickness="1" Padding="4">
              <local:OperatorOeeControl x:Name="OperatorOeeChart"/>
            </Border>
            <Border x:Name="CardMonthChart" Grid.Row="1" Margin="0,6,0,0" CornerRadius="10" BorderThickness="1" Padding="2">
              <oxy:PlotView x:Name="PlotMonth"/>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
