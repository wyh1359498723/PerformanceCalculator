<Window x:Class="PerformanceCalculator2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:PerformanceCalculator2"
        mc:Ignorable="d"
        Title="生产绩效控制台" Height="820" Width="1280" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Storyboard x:Key="IntroStoryboard">
      <DoubleAnimation Storyboard.TargetName="RootDock" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.45" FillBehavior="HoldEnd">
        <DoubleAnimation.EasingFunction>
          <QuadraticEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="DockSlide" Storyboard.TargetProperty="Y"
                       From="22" To="0" Duration="0:0:0.5" FillBehavior="HoldEnd">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="DragPulseStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="DropScanLine" Storyboard.TargetProperty="Opacity"
                       From="0.2" To="1" Duration="0:0:0.55" AutoReverse="True"/>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource IntroStoryboard}"/>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="RootChrome" Background="#05080f">
    <!-- 深空渐变底 -->
    <Grid x:Name="TechBackdrop" Visibility="Visible">
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1.1,1.2">
            <GradientStop Color="#FF040a12" Offset="0"/>
            <GradientStop Color="#FF0c1830" Offset="0.42"/>
            <GradientStop Color="#FF051e24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Opacity="0.35" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.85" RadiusY="0.9">
            <GradientStop Color="#3322d3ee" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <DockPanel x:Name="RootDock" Background="Transparent" Opacity="0">
      <DockPanel.RenderTransform>
        <TranslateTransform x:Name="DockSlide"/>
      </DockPanel.RenderTransform>

      <Border x:Name="PanelTop" DockPanel.Dock="Top" Padding="16,12" SnapsToDevicePixels="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="生产绩效控制台" FontSize="24" FontWeight="Bold" Foreground="#e0fbff"/>
                <Border Margin="14,8,0,0" Padding="10,3" CornerRadius="6" VerticalAlignment="Bottom"
                        BorderBrush="#5522d3ee" BorderThickness="1" Background="#1a2238">
                  <TextBlock Text="RP0 专线 · 本地持久化" FontSize="11" Foreground="#7dd3fc" Opacity="0.95"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="LblPath" Margin="0,6,0,0" Text="尚未加载文件" TextWrapping="Wrap"
                         Foreground="#94a3b8" FontSize="12"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="BtnExportOperatorChart" Content="导出操作员图" MinWidth="132" Height="36" Margin="0,0,10,0"
                      Click="BtnExportOperatorChart_Click"/>
              <Button x:Name="BtnExportMonthChart" Content="导出月度图" MinWidth="120" Height="36" Margin="0,0,10,0"
                      Click="BtnExportMonthChart_Click"/>
              <CheckBox x:Name="ChkDarkMode" Content="科幻深色" VerticalAlignment="Center" Margin="0,0,12,0"
                        IsChecked="False" Checked="ChkDarkMode_Changed" Unchecked="ChkDarkMode_Changed"/>
              <Button x:Name="BtnSelectFiles" Content="选择 Excel" MinWidth="140" Height="36" Click="BtnSelectFiles_Click"/>
            </WrapPanel>
          </Grid>

          <Border x:Name="PanelDrop" Grid.Row="1" Height="48" CornerRadius="10" BorderThickness="1.5"
                  AllowDrop="True" PreviewDragOver="PanelDrop_PreviewDragOver" DragLeave="PanelDrop_DragLeave"
                  Drop="PanelDrop_Drop" PreviewDragEnter="PanelDrop_PreviewDragEnter">
            <Grid>
              <TextBlock x:Name="LblDropHint" Text="拖放 .xlsx 到此处合并导入，或使用上方「选择 Excel」"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7dd3fc" FontSize="13"/>
              <Border x:Name="DropScanLine" Height="2" VerticalAlignment="Bottom" Margin="24,0" CornerRadius="1"
                      Opacity="0.55" Background="#22d3ee" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <Border x:Name="PanelImportProgress" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0" Padding="8,8"
                  CornerRadius="8" BorderThickness="1" BorderBrush="#4422d3ee" Background="#120f1c">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LblImportDetail" Grid.Row="0" Margin="0,0,0,6" Foreground="#bae6fd" FontSize="12"/>
              <ProgressBar x:Name="ProgressImport" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="0"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid x:Name="MainGrid" Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="CardLeft" Grid.Column="0" Margin="0,0,10,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="PanelPerf" Grid.Row="0" Margin="0,0,0,12" Padding="4,2,4,8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="148"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="绩效表月份" VerticalAlignment="Center" Margin="0,6,8,0" Foreground="#7dd3fc" FontWeight="SemiBold"/>
                  <ComboBox x:Name="CboPerfMonth" Width="128" Margin="0,0,14,0" VerticalAlignment="Center"
                            SelectionChanged="CboPerfMonth_SelectionChanged"/>
                  <TextBlock x:Name="LblAvgEffective" Text="平均有效工时：—" VerticalAlignment="Center" Margin="0,6,12,0"
                             MinWidth="200" Foreground="#e2e8f0"/>
                  <CheckBox x:Name="ChkBelowAvg" Content="仅显示低于平均有效工时" VerticalAlignment="Center" Margin="0,0,12,0"
                            Checked="ChkBelowAvg_Changed" Unchecked="ChkBelowAvg_Changed"/>
                  <Button x:Name="BtnExportPerfMonth" Content="导出当月绩效表" Padding="14,6" Margin="0,0,10,0"
                          Click="BtnExportPerfMonth_Click"/>
                  <Button x:Name="BtnHistory" Content="数据源管理" Padding="14,6" Click="BtnHistory_Click"/>
                </WrapPanel>

                <TextBlock x:Name="LblChartMonthHint" Grid.Row="1" Text="图表统计月份（多选，默认全选）"
                           VerticalAlignment="Center" Margin="0,8,0,6" FontSize="12"/>

                <Border x:Name="BdChartMonthPicker" Grid.Row="2" CornerRadius="8" Padding="8" BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChartMonthItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SelectableMonth}">
                          <CheckBox Margin="0,4" Content="{Binding MonthKey}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Checked="ChartMonthCheck_Changed" Unchecked="ChartMonthCheck_Changed"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>

            <DataGrid x:Name="DgvOperators" Grid.Row="1" Margin="0,0,0,12" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column"/>
            <DataGrid x:Name="DgvMonths" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"/>
          </Grid>
        </Border>

        <Border x:Name="CardRight" Grid.Column="1" Margin="10,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="10" BorderThickness="1" BorderBrush="#3322d3ee" Background="#0a1220"
                    Padding="4">
              <local:OperatorOeeControl x:Name="OperatorOeeChart"/>
            </Border>
            <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" BorderBrush="#3322d3ee" Background="#0a1220"
                    Padding="2">
              <oxy:PlotView x:Name="PlotMonth"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
